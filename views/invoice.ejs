<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice - <%= order.txn_ref %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { background: #f8f9fa; }
        .invoice-box {
            width: 100%;
            max-width: 600px; /* Further reduced to strictly fit A4 */
            margin: auto;
            border: 1px solid #eee;
            box-shadow: 0 0 10px rgba(0, 0, 0, .05);
            background: #fff;
            padding: 20px;
        }
        @media print {
            body { background: #fff; }
            .invoice-box { border: none; box-shadow: none; padding: 0; max-width: 100%; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body class="py-5">

    <div class="invoice-box">
        <!-- Header Actions -->
        <div class="d-flex justify-content-between mb-4 no-print">
            <a href="/orders" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Back to Orders
            </a>
            <div>
                <button onclick="window.print()" class="btn btn-outline-primary btn-sm me-2">
                    <i class="bi bi-printer me-1"></i>Print
                </button>
                <button id="btnDownload" class="btn btn-primary btn-sm">
                    <i class="bi bi-download me-1"></i>Download PDF
                </button>
            </div>
        </div>

        <!-- content wrapper for pdf -->
        <div id="invoice-content">
            <!-- Title -->
            <div class="d-flex justify-content-between align-items-center border-bottom pb-4 mb-4">
                <div>
                    <h2 class="fw-bold text-primary mb-1">INVOICE</h2>
                    <p class="text-muted mb-0">JustFee Supermarket</p>
                </div>
                <div class="text-end">
                    <div class="display-6"><i class="bi bi-basket3-fill text-primary"></i></div>
                </div>
            </div>

            <!-- Info Grid (Table Layout for better PDF rendering) -->
            <table class="table table-borderless mb-4">
                <tr>
                    <td class="ps-0">
                        <h6 class="text-muted text-uppercase small fw-bold">Billed To</h6>
                        <p class="mb-0 fw-bold"><%= order.user ? order.user.name : 'Valued Customer' %></p>
                        <p class="mb-0"><%= order.user ? order.user.email : '' %></p>
                    </td>
                    <td class="text-end pe-0">
                        <h6 class="text-muted text-uppercase small fw-bold">Invoice Details</h6>
                        <p class="mb-0"><strong>Ref:</strong> #<%= order.txn_ref %></p>
                        <p class="mb-0"><strong>Date:</strong> <%= new Date(order.created_at).toLocaleDateString('en-SG', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                        <p class="mb-0"><strong>Time:</strong> <%= new Date(order.created_at).toLocaleTimeString('en-SG') %></p>
                        <p class="mb-0"><strong>Status:</strong> <span class="badge bg-success"><%= order.status %></span></p>
                    </td>
                </tr>
            </table>

            <!-- Items Table -->
            <div class="mb-4">
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Item Description</th>
                            <th scope="col" class="text-center" width="100">Price</th>
                            <th scope="col" class="text-center" width="80">Qty</th>
                            <th scope="col" class="text-end" width="120">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (order.items && order.items.length > 0) { %>
                            <% order.items.forEach(item => { %>
                                <tr>
                                    <td><%= item.product_name %></td>
                                    <td class="text-center">$<%= parseFloat(item.price).toFixed(2) %></td>
                                    <td class="text-center"><%= item.quantity %></td>
                                    <td class="text-end fw-bold">$<%= (item.price * item.quantity).toFixed(2) %></td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="text-center text-muted">No details available (Legacy Order)</td>
                            </tr>
                        <% } %>
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="3" class="text-end fw-bold">Total Amount</td>
                            <td class="text-end fw-bold text-primary fs-5">$<%= parseFloat(order.amount).toFixed(2) %></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Footer -->
            <div class="row text-muted small mt-5">
                <div class="col-md-6">
                    <p class="mb-1"><strong>Payment Method:</strong> <%= order.provider %></p>
                    <p><strong>Transaction Ref:</strong> <%= order.provider_ref ? order.provider_ref : '-' %></p>
                </div>
                <div class="col-md-6 text-end">
                    <p class="mb-0">Thank you for shopping with JustFee!</p>
                    <p class="mb-0">For support, contact help@justfee.com</p>
                </div>
            </div>
        </div>
    </div>

    <!-- html2pdf Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script>
        document.getElementById('btnDownload').addEventListener('click', function() {
            const element = document.getElementById('invoice-content');
            
            // Add some padding/styling for PDF
            const opt = {
                margin:       0.5,
                filename:     'JustFee_Invoice_<%= order.txn_ref %>.pdf',
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true },
                jsPDF:        { unit: 'in', format: 'a4', orientation: 'portrait' }
            };

            // New Promise-based usage:
            html2pdf().set(opt).from(element).save();
        });
    </script>
    </div>

</body>
</html>

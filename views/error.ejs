<%- include('partials/header') %>

<div class="text-center py-5">
    <div class="display-1 text-danger mb-4">
        <i class="bi bi-exclamation-triangle"></i>
    </div>
    <h1 class="display-4 fw-bold">Something Went Wrong</h1>
    <p class="lead text-muted mb-4"><%= message || 'An unexpected error occurred.' %></p>
    
    <% if (typeof error !== 'undefined' && error.stack) { %>
        <div class="card text-start mx-auto mb-4" style="max-width: 600px;">
            <div class="card-header bg-danger text-white">
                <small>Error Details (Development Mode)</small>
            </div>
            <div class="card-body">
                <pre class="mb-0 small text-danger"><%= error.stack %></pre>
            </div>
        </div>
    <% } %>
    
    <div class="d-flex gap-3 justify-content-center">
        <a href="javascript:history.back()" class="btn btn-secondary btn-lg">
            <i class="bi bi-arrow-left me-2"></i>Go Back
        </a>
        <a href="/" class="btn btn-primary btn-lg">
            <i class="bi bi-house me-2"></i>Go Home
        </a>
    </div>
</div>

<%- include('partials/footer') %>

<%- include('partials/header') %>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <!-- Success Message -->
        <div class="text-center mb-4">
            <div class="display-1 text-primary mb-3">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <h1 class="display-5 fw-bold text-primary">Order Confirmed!</h1>
            <p class="lead text-muted">Thank you for your purchase</p>
        </div>

        <!-- Order Details Card -->
        <div class="card shadow">
            <div class="card-header text-white" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                <h5 class="mb-0">
                    <i class="bi bi-receipt me-2"></i>Order Details
                </h5>
            </div>
            <div class="card-body">
                <!-- Order Date -->
                <div class="mb-3 pb-3 border-bottom">
                    <small class="text-muted">Order Date</small>
                    <p class="mb-0 fw-bold"><%= orderDate %></p>
                </div>

                <!-- Customer Info -->
                <div class="mb-3 pb-3 border-bottom">
                    <small class="text-muted">Customer</small>
                    <p class="mb-0 fw-bold"><%= user.username %></p>
                    <p class="mb-0 small text-muted"><%= user.email %></p>
                </div>

                <!-- Order Items -->
                <div class="mb-3">
                    <small class="text-muted">Items Ordered</small>
                    <div class="table-responsive mt-2">
                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Product</th>
                                    <th class="text-center" width="80">Qty</th>
                                    <th class="text-end" width="100">Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% orderItems.forEach(function(item) { %>
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="/images/<%= item.image %>" 
                                                     alt="<%= item.productName %>" 
                                                     class="me-2 rounded"
                                                     style="width: 40px; height: 40px; object-fit: cover;">
                                                <%= item.productName %>
                                            </div>
                                        </td>
                                        <td class="text-center"><%= item.quantity %></td>
                                        <td class="text-end">$<%= (item.price * item.quantity).toFixed(2) %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="2" class="text-end fw-bold">Total:</td>
                                    <td class="text-end fw-bold text-primary fs-5">
                                        $<%= orderTotal.toFixed(2) %>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-light">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small">
                        <i class="bi bi-check-circle text-success me-1"></i>
                        Stock has been updated
                    </span>
                    <span class="badge bg-success">Completed</span>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex gap-3 justify-content-center mt-4">
            <a href="/shopping" class="btn btn-primary btn-lg">
                <i class="bi bi-shop me-2"></i>Continue Shopping
            </a>
            <a href="/" class="btn btn-outline-secondary btn-lg">
                <i class="bi bi-house me-2"></i>Go Home
            </a>
        </div>

        <!-- Thank You Message -->
        <div class="text-center mt-5">
            <p class="text-muted">
                <i class="bi bi-heart-fill text-danger me-1"></i>
                Thank you for shopping with JustFee!
            </p>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

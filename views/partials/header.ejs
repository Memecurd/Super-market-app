<!-- 
    Header Partial (views/partials/header.ejs)
    Includes: DOCTYPE, head section, and navbar
    Variables expected: title, user, cartCount
-->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>JustFee</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark shadow-sm" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);"">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <i class="bi bi-basket3-fill me-2"></i>
                <span class="fw-bold">JustFee</span>
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <% if (user) { %>
                        <% if (user.role === 'admin') { %>
                            <!-- Admin Navigation -->
                            <li class="nav-item">
                                <a class="nav-link" href="/inventory">
                                    <i class="bi bi-box-seam me-1"></i>Inventory
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/addProduct">
                                    <i class="bi bi-plus-circle me-1"></i>Add Product
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/admin/orders">
                                    <i class="bi bi-shield-lock me-1"></i>Manage Orders
                                </a>
                            </li>
                        <% } %>
                        
                        <!-- User Navigation (available to all logged-in users) -->
                        <li class="nav-item">
                            <a class="nav-link" href="/shopping">
                                <i class="bi bi-shop me-1"></i>Shop
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/orders">
                                <i class="bi bi-receipt me-1"></i>Orders
                            </a>
                        </li>
                    <% } %>
                </ul>
                
                <ul class="navbar-nav">
                    <% if (user) { %>
                        <!-- Cart Link with Badge -->
                        <li class="nav-item me-3">
                            <a class="nav-link position-relative" href="/cart">
                                <i class="bi bi-cart3"></i> Cart
                                <% if (cartCount > 0) { %>
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                        <%= cartCount %>
                                    </span>
                                <% } %>
                            </a>
                        </li>
                        
                        <!-- User Dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i>
                                <%= user.username %>
                                <span class="badge bg-light text-primary ms-1"><%= user.role %></span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><span class="dropdown-item-text text-muted small">Logged in as <%= user.email %></span></li>
                                <li>
                                    <a class="dropdown-item" href="/orders">
                                        <i class="bi bi-receipt me-1"></i>My Orders
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-danger" href="/logout">
                                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                                    </a>
                                </li>
                            </ul>
                        </li>
                    <% } else { %>
                        <!-- Guest Navigation -->
                        <li class="nav-item">
                            <a class="nav-link" href="/login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/register">
                                <i class="bi bi-person-plus me-1"></i>Register
                            </a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Flash Messages -->
    <div class="container mt-3">
        <% if (typeof success !== 'undefined' && success.length > 0) { %>
            <% success.forEach(function(msg) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i><%= msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% }); %>
        <% } %>
        
        <% if (typeof error !== 'undefined' && error.length > 0) { %>
            <% error.forEach(function(msg) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i><%= msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% }); %>
        <% } %>
    </div>

    <!-- Main Content Container -->
    <main class="container py-4">

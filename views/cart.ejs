<%- include('partials/header') %>

    <h2 class="mb-4">
        <i class="bi bi-cart3 me-2"></i>Shopping Cart
    </h2>

    <% if (cart.length===0) { %>
        <!-- Empty Cart -->
        <div class="text-center py-5">
            <i class="bi bi-cart-x display-1 text-muted mb-4"></i>
            <h3 class="text-muted">Your cart is empty</h3>
            <p class="text-muted mb-4">Looks like you haven't added any products yet.</p>
            <a href="/shopping" class="btn btn-primary btn-lg">
                <i class="bi bi-shop me-2"></i>Start Shopping
            </a>
        </div>
        <% } else { %>
            <div class="row">
                <!-- Cart Items -->
                <div class="col-lg-8 mb-4">
                    <div class="card shadow-sm">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Cart Items (<%= cart.length %>)</h5>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 align-middle">
                                <thead>
                                    <tr>
                                        <th width="100">Image</th>
                                        <th>Product</th>
                                        <th width="100" class="text-end">Price</th>
                                        <th width="150" class="text-center">Quantity</th>
                                        <th width="100" class="text-end">Subtotal</th>
                                        <th width="50" class="text-center">Remove</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% cart.forEach(function(item) { %>
                                        <tr>
                                            <td>
                                                <img src="/images/<%= item.image %>" alt="<%= item.productName %>"
                                                    class="img-thumbnail"
                                                    style="width: 70px; height: 70px; object-fit: cover;">
                                            </td>
                                            <td>
                                                <a href="/product/<%= item.productId %>" class="text-decoration-none">
                                                    <strong>
                                                        <%= item.productName %>
                                                    </strong>
                                                </a>
                                                <% if (item.maxStock <=item.quantity) { %>
                                                    <br><small class="text-warning">
                                                        <i class="bi bi-exclamation-triangle"></i> Max available
                                                    </small>
                                                    <% } %>
                                            </td>
                                            <td class="text-end">$<%= item.price.toFixed(2) %>
                                            </td>
                                            <td class="text-center">
                                                <!-- Update Quantity Form -->
                                                <form action="/cart/update/<%= item.productId %>" method="POST"
                                                    class="d-inline">
                                                    <div class="input-group input-group-sm" style="width: 100px;">
                                                        <input type="number" class="form-control text-center"
                                                            name="quantity" value="<%= item.quantity %>" min="1"
                                                            max="<%= item.maxStock %>" onchange="this.form.submit()">
                                                    </div>
                                                </form>
                                            </td>
                                            <td class="text-end fw-bold">
                                                $<%= (item.price * item.quantity).toFixed(2) %>
                                            </td>
                                            <td class="text-center">
                                                <a href="/cart/remove/<%= item.productId %>"
                                                    class="btn btn-sm btn-outline-danger" title="Remove item"
                                                    onclick="return confirm('Remove <%= item.productName %> from cart?')">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </td>
                                        </tr>
                                        <% }); %>
                                </tbody>
                            </table>
                        </div>
                        <div class="card-footer">
                            <a href="/shopping" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Continue Shopping
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Order Summary & Checkout -->
                <div class="col-lg-4">
                    <!-- Order Summary Card -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-header text-white"
                            style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                            <h5 class="mb-0">
                                <i class="bi bi-receipt me-2"></i>Order Summary
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Subtotal (<%= cart.reduce((sum, item)=> sum + item.quantity, 0) %> items):</span>
                                <span>$<%= total.toFixed(2) %></span>
                            </div>
                            <div class="d-flex justify-content-between mb-2 text-muted">
                                <span>Shipping:</span>
                                <span>Free</span>
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between mb-0">
                                <span class="fs-5 fw-bold">Total:</span>
                                <span class="fs-5 fw-bold text-primary">$<%= total.toFixed(2) %></span>
                            </div>
                        </div>
                    </div>

                    <!-- Standard Checkout (Hidden/Deprioritized) -->
                    <!-- 
            <div class="card shadow-sm mb-4 bg-light">
                <div class="card-body">
                    <form action="/cart/checkout" method="POST">
                        <button type="submit" class="btn btn-outline-secondary w-100" disabled>
                            Standard Checkout (Disabled)
                        </button>
                    </form>
                </div>
            </div>
            -->

                    <!-- PayPal Checkout -->
                    <div class="card shadow-sm border-primary mb-3">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-paypal me-2"></i>Pay with PayPal
                            </h5>
                        </div>
                        <div class="card-body">
                            <div id="paypal-button-container"></div>
                        </div>
                    </div>

                    <!-- NETS QR Checkout -->
                    <div class="card shadow-sm border-danger">
                        <div class="card-header bg-danger text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-qr-code me-2"></i>Pay with NETS QR
                            </h5>
                        </div>
                        <div class="card-body">
                            <button class="btn btn-danger w-100 py-2" id="btnNetsPay">
                                Scan NETS QR to Pay
                            </button>
                        </div>
                    </div>

                </div>
            </div>
            <% } %>

                <!-- NETS QR Modal -->
                <div class="modal fade" id="netsQrModal" tabindex="-1" data-bs-backdrop="static">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header bg-danger text-white">
                                <h5 class="modal-title">Scan to Pay</h5>
                                <button type="button" class="btn-close btn-close-white"
                                    data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body text-center">
                                <div id="netsQrLoader" class="d-none py-4">
                                    <div class="spinner-border text-danger" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                    <p class="mt-2">Generating QR Code...</p>
                                </div>

                                <div id="netsQrContent" class="d-none">
                                    <p class="mb-3">Scan this QR code with your NETS app</p>
                                    <div class="border p-2 d-inline-block rounded mb-3">
                                        <img id="netsQrImage" src="" alt="NETS QR" class="img-fluid"
                                            style="width: 250px; height: 250px;">
                                    </div>
                                    <div class="alert alert-info py-2">
                                        <small>Amount to Pay: <strong>$<span
                                                    id="netsAmount">0.00</span></strong></small>
                                    </div>

                                    <div class="alert alert-info py-2">
                                        <small>Amount to Pay: <strong>$<span
                                                    id="netsAmount">0.00</span></strong></small>
                                    </div>

                                    <p class="text-muted small">
                                        <span class="spinner-grow spinner-grow-sm text-danger me-1"></span>
                                        Waiting for payment...
                                    </p>
                                    <div id="sseStatus" class="small text-muted"></div>
                                </div>

                                <div id="netsQrError" class="d-none alert alert-danger">
                                    Failed to load QR Code. Please try again.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <%- include('partials/footer') %>

                    <% if (cart.length> 0) { %>
                        <!-- PayPal SDK -->
                        <script
                            src="https://www.paypal.com/sdk/js?client-id=<%= paypalClientId %>&currency=SGD"></script>

                        <!-- Payment Scripts -->
                        <script>
                            // ===================================
                            // PAYPAL INTEGRATION
                            // ===================================
                            if (typeof paypal !== 'undefined') {
                                paypal.Buttons({
                                    style: {
                                        layout: 'vertical',
                                        color: 'gold',
                                        shape: 'rect',
                                        label: 'paypal'
                                    },

                                    // Call your server to set up the transaction
                                    createOrder: function (data, actions) {
                                        return fetch('/api/paypal/create-order', {
                                            method: 'post'
                                        }).then(function (res) {
                                            return res.json();
                                        }).then(function (orderData) {
                                            return orderData.id;
                                        });
                                    },

                                    // Call your server to finalize the transaction
                                    onApprove: function (data, actions) {
                                        return fetch('/api/paypal/capture-order', {
                                            method: 'post',
                                            headers: {
                                                'content-type': 'application/json'
                                            },
                                            body: JSON.stringify({
                                                orderID: data.orderID
                                            })
                                        }).then(function (res) {
                                            return res.json();
                                        }).then(function (orderData) {
                                            // Check for error detail
                                            if (orderData.error) {
                                                alert('Payment failed: ' + orderData.error);
                                                window.location.href = '/payment/fail';
                                            } else if (orderData.status === 'COMPLETED') {
                                                // Redirect to success page
                                                window.location.href = '/payment/success';
                                            }
                                        });
                                    },

                                    onCancel: function (data) {
                                        window.location.href = '/payment/fail?reason=cancelled';
                                    }
                                }).render('#paypal-button-container');
                            } else {
                                const debugId = '<%= paypalClientId %>';
                                console.error('PayPal SDK not loaded');
                                document.getElementById('paypal-button-container').innerHTML =
                                    '<div class="alert alert-warning">' +
                                    '<i class="bi bi-exclamation-triangle me-2"></i>' +
                                    'PayPal could not be loaded.<br>Debug Info: Client ID is ' + (debugId ? 'PRESENT (' + debugId.substring(0, 5) + '...)' : 'MISSING') +
                                    '</div>';
                            }

                            // ===================================
                            // NETS QR INTEGRATION
                            // ===================================
                            const btnNetsPay = document.getElementById('btnNetsPay');
                            // Wait for DOM to be ready just in case, but footer placement should solve it
                            // Moved declaration inside click to be safe or ensure bootstrap is loaded
                            // We will use new bootstrap.Modal inside the event listener or ensure this script runs after bootstrap

                            let netsModal;
                            // Initialize Modal safely
                            try {
                                netsModal = new bootstrap.Modal(document.getElementById('netsQrModal'));
                            } catch (e) {
                                console.error('Bootstrap not loaded?', e);
                            }

                            const netsQrLoader = document.getElementById('netsQrLoader');
                            const netsQrContent = document.getElementById('netsQrContent');
                            const netsQrImage = document.getElementById('netsQrImage');
                            const netsAmount = document.getElementById('netsAmount');
                            const netsQrError = document.getElementById('netsQrError');

                            let eventSource = null;
                            let currentTxnRef = null;

                            btnNetsPay.addEventListener('click', async () => {
                                // Reset state
                                netsQrLoader.classList.remove('d-none');
                                netsQrContent.classList.add('d-none');
                                netsQrError.classList.add('d-none');

                                if (netsModal) netsModal.show();

                                try {

                                    // 1. Request QR Code
                                    const response = await fetch('/api/nets/qr', { method: 'POST' });

                                    const data = await response.json();


                                    if (data.error) throw new Error(data.error);

                                    // 2. Display QR
                                    netsQrImage.src = data.qrImage;
                                    netsAmount.textContent = data.amount.toFixed(2);
                                    currentTxnRef = data.txnRef; // Store Ref

                                    netsQrLoader.classList.add('d-none');
                                    netsQrContent.classList.remove('d-none');

                                    // 3. Start Polling (SSE)

                                    startNetsPolling(currentTxnRef);

                                } catch (error) {
                                    console.error('NETS Frontend Error:', error);
                                    netsQrLoader.classList.add('d-none');
                                    netsQrError.classList.remove('d-none');
                                    netsQrError.innerText = 'Error: ' + error.message;
                                }
                            });


                            function startNetsPolling(txnRef) {
                                if (eventSource) eventSource.close();

                                eventSource = new EventSource(`/sse/payment-status/${txnRef}`);

                                eventSource.onmessage = (event) => {
                                    const data = JSON.parse(event.data);


                                    if (data.status === 'SUCCESS') {
                                        eventSource.close();
                                        window.location.href = '/payment/success';
                                    } else if (data.status === 'FAILED') {
                                        eventSource.close();
                                        window.location.href = '/payment/fail';
                                    } else if (data.status === 'TIMEOUT') {
                                        eventSource.close();
                                        alert('Payment timed out. Please try again.');
                                        if (netsModal) netsModal.hide();
                                    }
                                };

                                eventSource.onerror = () => {
                                    console.error('SSE Error, closing connection');
                                    eventSource.close();
                                };
                            }

                            // Stop polling when modal is closed
                            document.getElementById('netsQrModal').addEventListener('hidden.bs.modal', () => {
                                if (eventSource) {
                                    eventSource.close();
                                    eventSource = null;
                                }
                            });

                        </script>
                        <% } %>
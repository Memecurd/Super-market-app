<%- include('partials/header') %>

<h2 class="mb-4">
    <i class="bi bi-cart3 me-2"></i>Shopping Cart
</h2>

<% if (cart.length === 0) { %>
    <!-- Empty Cart -->
    <div class="text-center py-5">
        <i class="bi bi-cart-x display-1 text-muted mb-4"></i>
        <h3 class="text-muted">Your cart is empty</h3>
        <p class="text-muted mb-4">Looks like you haven't added any products yet.</p>
        <a href="/shopping" class="btn btn-primary btn-lg">
            <i class="bi bi-shop me-2"></i>Start Shopping
        </a>
    </div>
<% } else { %>
    <div class="row">
        <!-- Cart Items -->
        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Cart Items (<%= cart.length %>)</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead>
                            <tr>
                                <th width="100">Image</th>
                                <th>Product</th>
                                <th width="100" class="text-end">Price</th>
                                <th width="150" class="text-center">Quantity</th>
                                <th width="100" class="text-end">Subtotal</th>
                                <th width="50" class="text-center">Remove</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% cart.forEach(function(item) { %>
                                <tr>
                                    <td>
                                        <img src="/images/<%= item.image %>" 
                                             alt="<%= item.productName %>" 
                                             class="img-thumbnail"
                                             style="width: 70px; height: 70px; object-fit: cover;">
                                    </td>
                                    <td>
                                        <a href="/product/<%= item.productId %>" class="text-decoration-none">
                                            <strong><%= item.productName %></strong>
                                        </a>
                                        <% if (item.maxStock <= item.quantity) { %>
                                            <br><small class="text-warning">
                                                <i class="bi bi-exclamation-triangle"></i> Max available
                                            </small>
                                        <% } %>
                                    </td>
                                    <td class="text-end">$<%= item.price.toFixed(2) %></td>
                                    <td class="text-center">
                                        <!-- Update Quantity Form -->
                                        <form action="/cart/update/<%= item.productId %>" method="POST" class="d-inline">
                                            <div class="input-group input-group-sm" style="width: 100px;">
                                                <input type="number" 
                                                       class="form-control text-center" 
                                                       name="quantity" 
                                                       value="<%= item.quantity %>"
                                                       min="1"
                                                       max="<%= item.maxStock %>"
                                                       onchange="this.form.submit()">
                                            </div>
                                        </form>
                                    </td>
                                    <td class="text-end fw-bold">
                                        $<%= (item.price * item.quantity).toFixed(2) %>
                                    </td>
                                    <td class="text-center">
                                        <a href="/cart/remove/<%= item.productId %>" 
                                           class="btn btn-sm btn-outline-danger"
                                           title="Remove item"
                                           onclick="return confirm('Remove <%= item.productName %> from cart?')">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer">
                    <a href="/shopping" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Continue Shopping
                    </a>
                </div>
            </div>
        </div>
        
        <!-- Order Summary & Checkout -->
        <div class="col-lg-4">
            <!-- Order Summary Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-header text-white" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                    <h5 class="mb-0">
                        <i class="bi bi-receipt me-2"></i>Order Summary
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal (<%= cart.reduce((sum, item) => sum + item.quantity, 0) %> items):</span>
                        <span>$<%= total.toFixed(2) %></span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 text-muted">
                        <span>Shipping:</span>
                        <span>Free</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-0">
                        <span class="fs-5 fw-bold">Total:</span>
                        <span class="fs-5 fw-bold text-primary">$<%= total.toFixed(2) %></span>
                    </div>
                </div>
            </div>

            <!-- Standard Checkout -->
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-credit-card me-2"></i>Standard Checkout
                    </h5>
                </div>
                <div class="card-body">
                    <form action="/cart/checkout" method="POST">
                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            <i class="bi bi-bag-check me-2"></i>Proceed to Checkout
                        </button>
                    </form>
                    <p class="text-muted small mt-2 mb-0 text-center">
                        Complete your order and update inventory
                    </p>
                </div>
            </div>

            
            <div class="card shadow-sm border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-paypal me-2"></i>PayPal Checkout
                    </h5>
                </div>
                <div class="card-body">
                    <!-- PayPal Button Container -->
                    <!-- This div will be populated by the PayPal SDK -->
                    <div id="paypal-button-container"></div>
                    
                    <p class="text-muted small mt-3 mb-0 text-center">
                        <i class="bi bi-shield-check me-1"></i>
                        Secure payment powered by PayPal
                    </p>
                </div>
            </div>
        </div>
    </div>
<% } %>


<% if (cart.length > 0) { %>
<script src="https://www.paypal.com/sdk/js?client-id=AchcmUhV9fKPbFCUv2hion4_7DxJR3SilUXsTybI-_iiY8nxNazO3L7Ifbi0jxxFpmfSu54yrvMYtSKx&currency=SGD"></script>

<script>

    const cartTotal = '<%= total.toFixed(2) %>';
    
    // Check if PayPal SDK loaded successfully
    if (typeof paypal !== 'undefined') {
        paypal.Buttons({
            // ================================================
            // STYLE OPTIONS (customize as needed)
            // ================================================
            style: {
                layout: 'vertical',      // 'vertical' or 'horizontal'
                color:  'blue',          // 'gold', 'blue', 'silver', 'white', 'black'
                shape:  'rect',          // 'rect' or 'pill'
                label:  'paypal'         // 'paypal', 'checkout', 'buynow', 'pay'
            },
            
            // ================================================
            // CREATE ORDER
            // Called when the buyer clicks the PayPal button
            // 
            // NOTE: For production, create orders server-side
            // to prevent price manipulation
            // ================================================
            createOrder: function(data, actions) {
                return actions.order.create({
                    purchase_units: [{
                        description: 'SupermarketApp Order',
                        amount: {
                            currency_code: 'USD',
                            value: cartTotal
                        }
                    }]
                });
            },
            
            // ================================================
            // ON APPROVE
            // Called when the buyer approves the payment
            // ================================================
            onApprove: function(data, actions) {
                // Capture the payment
                return actions.order.capture().then(function(orderData) {
                    // Payment successful!
                    console.log('Payment completed:', orderData);
                    
                    // Get transaction details
                    const transaction = orderData.purchase_units[0].payments.captures[0];
                    
                    // Show success message
                    alert('Payment successful!\n\nTransaction ID: ' + transaction.id + '\nAmount: $' + transaction.amount.value);
                    
                    // ================================================
                    // TODO: In production, you should:
                    // 1. Send orderData to your server to verify
                    // 2. Clear the cart
                    // 3. Update inventory
                    // 4. Create an order record
                    // 5. Redirect to confirmation page
                    // 
                    // Example:
                    // fetch('/cart/paypal-checkout', {
                    //     method: 'POST',
                    //     headers: { 'Content-Type': 'application/json' },
                    //     body: JSON.stringify({ orderID: data.orderID })
                    // }).then(response => {
                    //     window.location.href = '/checkout/success';
                    // });
                    // ================================================
                    
                    // For demo purposes, redirect to checkout
                    // (In production, verify payment server-side first!)
                    document.querySelector('form[action="/cart/checkout"]').submit();
                });
            },
            
            // ================================================
            // ON CANCEL
            // Called if the buyer cancels the payment
            // ================================================
            onCancel: function(data) {
                console.log('Payment cancelled:', data);
                alert('Payment was cancelled. Your cart items are still saved.');
            },
            
            // ================================================
            // ON ERROR
            // Called if there's an error during payment
            // ================================================
            onError: function(err) {
                console.error('PayPal Error:', err);
                alert('An error occurred during payment. Please try again or use standard checkout.');
            }
            
        }).render('#paypal-button-container');
        // ^^^ Renders the buttons into the container div
        
    } else {
        // PayPal SDK failed to load
        // This usually means the Client ID is invalid or there's a network issue
        document.getElementById('paypal-button-container').innerHTML = 
            '<div class="alert alert-warning">' +
            '<i class="bi bi-exclamation-triangle me-2"></i>' +
            'PayPal is currently unavailable. Please use standard checkout.' +
            '</div>';
        console.error('PayPal SDK failed to load. Check your Client ID.');
    }
</script>
<% } %>

<%- include('partials/footer') %>
